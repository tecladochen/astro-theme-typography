---
import { themeConfig } from '~/.config'
import { getSocialIconClass } from '~/utils/socialIcons'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals
---

<nav class="flex flex-col items-start gap-3 sm:items-end">
  <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 text-[0.95rem]">
    {
      navLinks.map((nav) => (
        <li>
          <a href={nav.href}>{t(nav.name)}</a>
        </li>
      ))
    }
  </ul>
  <ul class="m-0 flex list-none items-center gap-3 p-0">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a
            href={href}
            target={href.startsWith('/') ? undefined : '_blank'}
            rel={href.startsWith('/') ? undefined : 'noopener noreferrer'}
            title={name}
            class="not-underline-hover inline-flex text-muted hover:text-accent"
          >
            <span class:list={[getSocialIconClass(name), 'h-5 w-5 shrink-0']} aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</nav>
