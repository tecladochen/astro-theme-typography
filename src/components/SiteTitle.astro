---
import { themeConfig } from '~/.config'

const { title, subtitle } = themeConfig.site
---

<a class="not-underline-hover group block" href="/">
  <p class="m-0 text-xs tracking-[0.22em] text-muted uppercase">{subtitle}</p>
  <p class="mt-1 mb-0 font-header text-[1.85rem] font-bold leading-none tracking-wide">
    {title}
  </p>
</a>
