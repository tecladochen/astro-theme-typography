---
import { themeConfig } from '~/.config'

const year = new Date().getFullYear()
const { website, author, footer } = themeConfig.site

function parseFooter(str: string) {
  return str
    .replace(/%author/g, author)
    .replace(/%website/g, website)
    .replace(/%year/g, year.toString())
}
---

<div class="flex flex-col gap-1 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
  {footer.map((str) => <p class="m-0" set:html={parseFooter(str)} />)}
</div>
