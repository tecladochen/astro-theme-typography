---
const { translate: t } = Astro.locals

interface Props {
  showLeft?: boolean
  leftTitle?: string
  leftUrl?: string
  showRight?: boolean
  rightTitle?: string
  rightUrl?: string
  showPageCount?: boolean
  currentPage?: number
  totalPage?: number
}

const {
  showLeft = true,
  showRight = true,
  leftTitle,
  rightTitle,
  leftUrl,
  rightUrl,
  showPageCount = true,
  currentPage,
  totalPage,
} = Astro.props
---

<footer class="mt-12 flex flex-col gap-3 text-sm">
  {
    showPageCount && (
      <div class="text-muted">
        {t('page_number', currentPage)} / {t('page_count', totalPage)}
      </div>
    )
  }
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
    {showLeft && leftUrl && <a href={leftUrl}>{leftTitle}</a>}
    {showRight && rightUrl && <a href={rightUrl}>{rightTitle}</a>}
  </div>
</footer>
