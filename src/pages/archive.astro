---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getPosts } from '~/utils'

const posts = await getPosts(true)
const yearMap = getYearMap(posts)

interface ListItem {
  title: string
  href: string
  date: string
}

function getYearMap(posts: Post[]) {
  const result = new Map<number, ListItem[]>()
  for (const post of posts) {
    const year = (post.data.pubDate ?? new Date()).getFullYear()
    const items = result.get(year) ?? []
    items.push(getListItem(post))
    result.set(year, items)
  }
  return Array.from(result.entries())
}

function getListItem(post: Post): ListItem {
  return {
    title: post.data.title,
    href: `/posts/${post.id}/`,
    date: formatDate(post.data.pubDate, 'MM-DD'),
  }
}
---

<LayoutDefault>
  <div class="flex flex-col gap-10">
    {
      yearMap.map(([year, items]) => (
        <section>
          <h2 class="post-title mb-5">{year}</h2>
          <ul class="m-0 flex list-none flex-col gap-4 p-0">
            {items.map(({ title, href, date }) => (
              <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <a class="not-underline-hover font-header text-lg font-bold" href={href}>
                  {title}
                </a>
                <time class="meta-text shrink-0">{date}</time>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</LayoutDefault>
