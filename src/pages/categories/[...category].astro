---
import { themeConfig } from '~/.config'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getCategories, getPathFromCategory } from '~/utils'

export async function getStaticPaths() {
  const categoryMap = await getCategories()
  return Array.from(categoryMap).map(([key, value]) => {
    const path = getPathFromCategory(key, themeConfig.site.categoryMap)
    return {
      params: { category: path },
      props: { posts: value, name: key },
    }
  })
}

interface Props {
  posts: Post[]
  name: string
}

const { posts, name } = Astro.props

const items = posts.map((post) => ({
  title: post.data.title,
  href: `/posts/${post.id}/`,
  date: formatDate(post.data.pubDate),
}))
---

<LayoutDefault>
  <section>
    <h2 class="post-title mb-6"># {name}</h2>
    <ul class="m-0 flex list-none flex-col gap-4 p-0">
      {
        items.map(({ title, href, date }) => (
          <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <a class="not-underline-hover font-header text-lg font-bold" href={href}>
              {title}
            </a>
            <time class="meta-text shrink-0">{date}</time>
          </li>
        ))
      }
    </ul>
  </section>
</LayoutDefault>
